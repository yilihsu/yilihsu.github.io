source 'https://rubygems.org'

ruby '3.2.2'  # <- choose this and use the same in CI

gem 'jekyll', '~> 4.3'

group :jekyll_plugins do
  gem 'jekyll-email-protect'
  gem 'jekyll-feed'
  gem 'jekyll-archives'
  gem 'jekyll-imagemagick'
  gem 'jekyll-diagrams'
  gem 'jekyll-minifier'
  gem 'jekyll-paginate-v2'
  gem 'jekyll-scholar'
  gem 'jekyll-sitemap'
  gem 'jekyll-link-attributes'
  gem 'jekyll-twitter-plugin'
  gem 'jemoji'
  gem 'jekyll-seo-tag'
end

# Keep only if you need it (often optional / trouble-prone):
gem 'mini_racer', platforms: :ruby

# Ruby 3+ needs this for `jekyll serve`
gem 'webrick', '~> 1.8'

group :other_plugins do
  gem 'httparty'
  gem 'feedjira'
end
